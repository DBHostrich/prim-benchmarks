+ */
+
+#ifndef DPU_TRANSFER_TRACE_H
+#define DPU_TRANSFER_TRACE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <dpu.h>
+#include <dpu_error.h>
+
+struct dpu_rank_t;
+struct dpu_transfer_matrix;
+
+enum upmem_transfer_trace_memory {
+    UPMEM_TRACE_MEMORY_UNKNOWN,
+    UPMEM_TRACE_MEMORY_IRAM,
+    UPMEM_TRACE_MEMORY_WRAM,
+    UPMEM_TRACE_MEMORY_MRAM,
+};
+
+enum upmem_transfer_trace_direction {
+    UPMEM_TRACE_DIRECTION_UNKNOWN,
+    UPMEM_TRACE_DIRECTION_H2D,
+    UPMEM_TRACE_DIRECTION_D2H,
+};
+
+struct upmem_transfer_trace_snapshot {
+    uint64_t wall_ns;
+    uint64_t thread_cpu_ns;
+    uint64_t process_cpu_ns;
+    int cpu_id;
+    long thread_nvcsw;
+    long thread_nivcsw;
+    long process_nvcsw;
+    long process_nivcsw;
+    uint32_t diagnostic_flags;
+};
+
+bool
+upmem_transfer_trace_enabled(void);
+
+struct upmem_transfer_trace_snapshot
+upmem_transfer_trace_snapshot(void);
+
+void
+upmem_transfer_trace_push_call(struct upmem_transfer_trace_snapshot start,
+    struct upmem_transfer_trace_snapshot end,
+    struct dpu_set_t dpu_set,
+    dpu_xfer_t xfer,
+    enum upmem_transfer_trace_memory memory,
+    size_t length,
+    dpu_xfer_flags_t flags,
+    dpu_error_t status);
+
+void
+upmem_transfer_trace_backend(struct upmem_transfer_trace_snapshot start,
+    struct upmem_transfer_trace_snapshot end,
+    struct dpu_rank_t *rank,
+    enum upmem_transfer_trace_direction direction,
+    const struct dpu_transfer_matrix *transfer_matrix,
+    dpu_error_t status);
+
+#endif

